{
  "name": "lexicon-marathon-170k",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run data:generate",
    "dev": "vite --host 127.0.0.1",
    "data:generate": "node scripts/generate-wordnet-data.mjs",
    "data:validate": "node scripts/validate-generated-data.mjs",
    "prebuild": "npm run data:generate",
    "build": "tsc -b && vite build && npm run data:validate -- --dist",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "adm-zip": "^0.5.16",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.15",
    "wrangler": "^4.103.0"
  }
}
